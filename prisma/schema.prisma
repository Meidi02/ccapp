generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("CHILD") // "MASTER" or "CHILD"
  createdAt    DateTime  @default(now())
  projects     Project[]
  twilioNumbers TwilioNumber[]
  dialerConfig DialerConfig?
}

model Project {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads     Lead[]
  createdAt DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String   @default("")
  email       String   @default("")
  phone       String   @default("")
  company     String   @default("")
  casualName  String   @default("")
  city        String   @default("")
  state       String   @default("")
  website     String   @default("")
  googleUrl   String   @default("")
  notes       String   @default("")
  disposition String   @default("NEW")
  callbackDate String  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallLog {
  id            String    @id @default(cuid())
  leadId        String
  leadName      String    @default("")
  leadPhone     String    @default("")
  callSid       String    @default("")
  status        String    @default("initiated")
  duration      Int       @default(0)
  notes         String    @default("")
  recordingSid  String    @default("")
  recordingUrl  String    @default("")
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  batchId       String?
}

model SmsLog {
  id        String   @id @default(cuid())
  leadId    String
  leadName  String   @default("")
  leadPhone String   @default("")
  body      String
  status    String   @default("sent")
  twilioSid String   @default("")
  direction String   @default("outbound")
  sentAt    DateTime @default(now())
}

model TwilioAccountProfile {
  id         String   @id @default(cuid())
  name       String
  accountSid String
  authToken  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TwilioNumber {
  id           String   @id @default(cuid())
  phoneNumber  String
  nickname     String?
  accountSid   String
  authToken    String
  assignedToId String?
  assignedTo   User?    @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DialerConfig {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxParallelDials Int      @default(1)
  selectedCallerIds String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String   // INFO, WARN, ERROR
  source    String   // FRONTEND, BACKEND, TWILIO
  message   String
  meta      Json?    // Optional JSON payload
  createdAt DateTime @default(now())
}
